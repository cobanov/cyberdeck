[Unit]
Description=Keep the DeckTerm demo container from opening connections
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Replies to inbound SSH pass; anything the container starts, to the LAN, tailnet, internet or this host, is dropped.
# In mangle, before routing: Tailscale's ts-forward accepts tailnet traffic ahead of Docker's DOCKER-USER chain.
ExecStart=/bin/sh -c 'iptables -t mangle -C PREROUTING -i br-deckdemo -m conntrack --ctstate NEW -j DROP 2>/dev/null || iptables -t mangle -I PREROUTING -i br-deckdemo -m conntrack --ctstate NEW -j DROP'

[Install]
WantedBy=docker.service
