      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol D"
          }
        }
      }
    },
    "Control Z": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol Z"
          }
        }
      }
    },
    "Couldn't read the backup: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek okunamadı: %@"
          }
        }
      }
    },
    "Couldn't read the key. Paste it in OpenSSH format (ed25519 or RSA) with its BEGIN and END lines, and its passphrase if it has one.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar okunamadı. OpenSSH biçiminde (ed25519 ya da RSA), BEGIN ve END satırlarıyla yapıştır; şifreliyse parolasını da gir."
          }
        }
      }
    },
    "Couldn't save the password to the Keychain": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola Keychain'e yazılamadı"
          }
        }
      }
    },
    "Couldn't save to the Keychain.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain'e yazılamadı."
          }
        }
      }
    },
    "DeckTerm backup": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DeckTerm yedeği"
          }
        }
      }
    },
    "DeckTerm is built on these open-source projects. Thank you to their authors.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DeckTerm bu açık kaynak projelerin üzerine kurulu. Yazarlarına teşekkürler."
          }
        }
      }
    },
    "DeckTerm is free, with no ads and no tracking. If it earns a place in your deck, a tip keeps it going. Tips unlock nothing.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DeckTerm ücretsiz; reklam yok, takip yok. Deck'inde kendine yer bulduysa bir bahşiş geliştirmeyi sürdürür. Bahşişler bir şey açmaz."
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sil"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        }
      }
    },
    "Down": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağı"
          }
        }
      }
    },
    "Edit": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenle"
          }
        }
      }
    },
    "Enter: reconnect · Esc: back": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter: yeniden bağlan · Esc: geri"
          }
        }
      }
    },
    "Escape": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc"
          }
        }
      }
    },
    "Export backup": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedeği dışa aktar"
          }
        }
      }
    },
    "Font": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazı tipi"
          }
        }
      }
    },
    "Forget host key": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Host anahtarını unut"
          }
        }
      }
    },
    "Hide keyboard": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyeyi gizle"
          }
        }
      }
    },
    "Hold and slide: arrow keys\nSwipe from the left: the list · from the right: this panel\n⌘W back · ⌘= ⌘- text size · ⌘, panel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basılı tut ve kaydır: yön tuşları\nSoldan çek: liste · Sağdan çek: bu panel\n⌘W geri · ⌘= ⌘- yazı boyutu · ⌘, panel"
          }
        }
      }
    },
    "Host key changed! The server presented %@. If you expected this, edit the device → Forget host key.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Host anahtarı değişti! Sunucunun sunduğu: %@. Değişikliği biliyorsan cihazı düzenle → Host anahtarını unut."
          }
        }
      }
    },
    "Key passphrase (if it has one)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar parolası (varsa)"
          }
        }
      }
    },
    "Keys and passwords never leave this iPhone": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarlar ve parolalar bu iPhone'dan çıkmaz"
          }
        }
      }
    },
    "Left": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol"
          }
        }
      }
    },
