    },
    "About DeckTerm": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DeckTerm hakkında"
          }
        }
      }
    },
    "Add a device": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz ekle"
          }
        }
      }
    },
    "Add an SSH key": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH anahtarı ekle"
          }
        }
      }
    },
    "Add an SSH server, then tap it to open its terminal.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir SSH sunucusu ekle; dokununca terminali açılır."
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres"
          }
        }
      }
    },
    "Amber": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehribar"
          }
        }
      }
    },
    "Back to list": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listeye dön"
          }
        }
