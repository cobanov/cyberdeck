      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekten geri yükle"
          }
        }
      }
    },
    "Restored %lld devices and your settings. Passwords and the SSH key are not in backups: paste the key once.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cihaz ve ayarların geri yüklendi. Parolalar ve SSH anahtarı yedekte yok: anahtarı bir kez yapıştır."
          }
        }
      }
    },
