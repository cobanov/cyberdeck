      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        }
      }
    },
    "Connecting to %@@%@…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@@%2$@ bağlanıyor…"
          }
        }
      }
    },
    "Connection lost.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı koptu."
          }
        }
      }
    },
    "Control C": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol C"
          }
        }
      }
    },
